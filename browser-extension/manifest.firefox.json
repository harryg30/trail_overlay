{
  "manifest_version": 2,
  "name": "Trail Overlay for Strava",
  "version": "1.0.2",
  "description": "Overlays mountain bike trails on Strava maps",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "permissions",
    "https://www.strava.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_permissions": [
    "https://*/*",
    "https://maps.googleapis.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.strava.com/maps/create/*",
        "https://www.strava.com/maps/*",
        "https://www.strava.com/routes/new",
        "https://www.strava.com/routes/*/edit"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "content-init.js",
    "content.js"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Trail Overlay Settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trail-overlay@harry.local",
      "strict_min_version": "109.0"
    }
  }
}
